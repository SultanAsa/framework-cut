<?xml version="1.0" encoding="UTF-8"?>
<!--
  FrameWork Cut's Windows Installer package, the .msi beside the Inno Setup .exe.

  Built by build-app.yml with WiX from the staged folder the .exe is made
  of, so the two installers ship the same files. The .exe is the
  one a person double-clicks; this is the one an administrator deploys -
  Group Policy, Intune, winget - and it installs for the machine, into
  Program Files, with a Start menu entry and a clean uninstall. Handed in:

    wix build -arch x64 -d Version=0.2.3 -d Root=C:\...\Concat
              -d Stage=C:\...\stage\Concat-0.2.3-windows-x86_64
              -o stage\Concat-0.2.3-windows-x86_64.msi assets\windows\concat.wxs

  Root is the repository: WiX resolves a source path against where it is
  run from, not against this file.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <!-- One upgrade code for the life of the product, so a newer .msi
       replaces an older one rather than sitting beside it. -->
  <Package Name="FrameWork Cut"
           Manufacturer="FrameWork"
           Version="$(var.Version)"
           UpgradeCode="1D8A4E63-72C5-4B90-8F2D-6E3A105C9B77"
           Scope="perMachine"
           Language="1033">
    <MajorUpgrade DowngradeErrorMessage="A newer version of FrameWork Cut is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="frameworkcut.ico" SourceFile="$(var.Root)\assets\icons\frameworkcut.ico" />
    <Property Id="ARPPRODUCTICON" Value="frameworkcut.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://framework.shop" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="FrameWork Cut" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ShortcutFolder" Name="FrameWork Cut" />
    </StandardDirectory>

    <Feature Id="Main" Title="FrameWork Cut" Level="1">
      <ComponentGroupRef Id="Program" />
      <ComponentRef Id="StartMenu" />
    </Feature>

    <!-- Every file in the staged folder, as it is there. -->
    <ComponentGroup Id="Program" Directory="INSTALLFOLDER">
      <Files Include="$(var.Stage)\**" />
    </ComponentGroup>

    <Component Id="StartMenu" Directory="ShortcutFolder" Guid="9B52E081-4C7A-4D16-A3F8-70B1C9D2E533">
      <Shortcut Id="StartMenuShortcut"
                Name="FrameWork Cut"
                Description="Video editor"
                Target="[INSTALLFOLDER]frameworkcut.exe"
                WorkingDirectory="INSTALLFOLDER"
                Icon="frameworkcut.ico" />
      <RemoveFolder Id="RemoveShortcutFolder" On="uninstall" />
      <RegistryValue Root="HKCU" Key="Software\FrameWork Cut" Name="StartMenu" Type="integer" Value="1" KeyPath="yes" />
    </Component>
  </Package>
</Wix>
